# Server-only Soniox credentials.
SONIOX_API_KEY=replace-with-your-soniox-api-key
SONIOX_API_BASE_URL=https://api.soniox.com/v1
SONIOX_MODEL=stt-async-v5

# Server-only Groq credentials (for Groq Whisper transcription engine).
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=whisper-large-v3-turbo

SERVER_HOST=127.0.0.1
SERVER_PORT=3001
